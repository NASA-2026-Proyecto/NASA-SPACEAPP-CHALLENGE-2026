# Plantilla procesada por el entrypoint de nginx (envsubst) al arrancar.
# Solo se sustituyen variables de entorno DEFINIDAS (BACKEND_URL, NGINX_LOCAL_RESOLVERS);
# las de nginx ($uri, $backend, $host...) quedan intactas.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cabeceras de seguridad. OJO: un add_header dentro de un location anula todos estos;
    # por eso las cachés de prod.conf usan "expires" y no add_header.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # DNS del entorno (en Docker, 127.0.0.11). Con un nombre en variable, nginx vuelve a
    # resolver el backend cada 10 s: si su contenedor se recrea con otra IP, sigue funcionando.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # API: misma URL que el front, así el navegador no necesita CORS.
    # ^~ evita que las reglas de caché por extensión (regex) capturen rutas de /api.
    location ^~ /api/ {
        set $backend ${BACKEND_URL};
        # Sin URI tras la variable: se reenvía la ruta original completa (/api/...)
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Nunca servir ficheros ocultos (.env, .git...)
    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Ajustes propios del modo: dev.conf o prod.conf (lo elige el target del Dockerfile)
    include /etc/nginx/snippets/mode.conf;
}
